{
  "name": "@clear-a11y/engine-widgets",
  "version": "0.1.0",
  "description": "Widget engine: drives custom widgets with the keyboard and checks them against the ARIA Authoring Practices keyboard contracts.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "aria",
    "apg",
    "keyboard",
    "testing"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clear-a11y/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/greenpioneersolutions/clear-a11y.git",
    "directory": "packages/engines/widgets"
  },
  "homepage": "https://greenpioneersolutions.github.io/clear-a11y/",
  "bugs": {
    "url": "https://github.com/greenpioneersolutions/clear-a11y/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clear-a11y/browser": "workspace:*",
    "@clear-a11y/core": "workspace:*",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clear-a11y/test-utils": "workspace:*"
  },
  "nx": {
    "tags": [
      "type:engine",
      "scope:widgets",
      "publish:public"
    ],
    "targets": {
      "test-integration": {}
    }
  }
}
