{
  "name": "@clear-a11y/browser",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clear-a11y/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@clear-a11y/core": "workspace:*",
    "playwright": "catalog:",
    "tslib": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenpioneersolutions/clear-a11y.git",
    "directory": "packages/browser"
  },
  "homepage": "https://greenpioneersolutions.github.io/clear-a11y/",
  "bugs": {
    "url": "https://github.com/greenpioneersolutions/clear-a11y/issues"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Clear A11Y browser layer: Playwright sessions, viewports, auth state, CDP, the engine contract and a local static server.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "playwright",
    "testing"
  ],
  "nx": {
    "tags": [
      "type:data-access",
      "scope:browser",
      "publish:public"
    ],
    "targets": {
      "test-integration": {}
    }
  }
}
