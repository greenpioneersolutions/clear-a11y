{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/vitest.integration.config.mts",
      "!{projectRoot}/playwright.config.ts",
      "!{projectRoot}/README.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      {
        "runtime": "node -p process.versions.node.split('.')[0]"
      }
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "exclude": ["fixtures/repos/**"],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "exclude": ["fixtures/repos/**"],
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "include": ["**/vitest.config.mts"],
      "exclude": ["fixtures/repos/**"],
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "exclude": ["fixtures/repos/**"],
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/vitest",
      "exclude": ["fixtures/repos/**"],
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test-integration": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "{workspaceRoot}/fixtures/**/*"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run -c vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "release": {
    "projects": ["tag:publish:public"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "preVersionCommand": "pnpm nx run-many -t build -p tag:publish:public",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "file": "{workspaceRoot}/CHANGELOG.md"
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): v{version}",
      "commitArgs": "--signoff",
      "tag": true,
      "push": true
    }
  },
  "sync": {
    "applyChanges": true
  },
  "analytics": false
}
