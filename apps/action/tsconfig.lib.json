{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/runner/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reporter/tsconfig.lib.json"
    },
    {
      "path": "../../packages/repo/tsconfig.lib.json"
    },
    {
      "path": "../../packages/core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/browser/tsconfig.lib.json"
    },
    {
      "path": "../../packages/test-utils/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "vitest.integration.config.mts"
  ]
}
