{
  "name": "clear-a11y",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clear-a11y/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "cli",
    "tags": [
      "type:app",
      "scope:cli",
      "publish:public"
    ],
    "targets": {
      "test-integration": {},
      "docs-json": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist/cli-reference.json"
        ],
        "cache": true,
        "options": {
          "command": "node dist/docs-json.js dist/cli-reference.json",
          "cwd": "{projectRoot}"
        }
      },
      "scan": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "options": {
          "command": "node apps/cli/dist/main.js scan"
        }
      }
    }
  },
  "dependencies": {
    "@clear-a11y/core": "workspace:*",
    "@clear-a11y/runner": "workspace:*",
    "@clear-a11y/reporter": "workspace:*",
    "commander": "catalog:",
    "tslib": "catalog:",
    "@clear-a11y/browser": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenpioneersolutions/clear-a11y.git",
    "directory": "apps/cli"
  },
  "homepage": "https://greenpioneersolutions.github.io/clear-a11y/",
  "bugs": {
    "url": "https://github.com/greenpioneersolutions/clear-a11y/issues"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": [
    "./dist/main.js",
    "./dist/docs-json.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "Clear A11Y command line: scan sites and repos for accessibility barriers like a human expert would.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe",
    "playwright",
    "testing"
  ],
  "bin": {
    "clear-a11y": "./dist/main.js"
  },
  "devDependencies": {
    "@clear-a11y/test-utils": "workspace:*"
  }
}
